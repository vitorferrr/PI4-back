# Supabase: use o Transaction pooler (porta 6543), não a conexão direta.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=no-verify
JWT_SECRET=troque-por-um-segredo-longo
# Só use true localmente. Na Vercel é ignorado.
ERASE_DATABASE_ON_SYNC=false

# Usado apenas por: npm run seed:admin
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=

# INT-06: Storage privado, exclusivamente no servidor. Nunca usar no frontend/mobile.
# SUPABASE_SECRET_KEY: chave sb_secret_... ou service_role legada, nunca anon/publishable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=documentos

# INT-03: envio de e-mail por SMTP (Gmail do projeto com senha de app).
# Porta 465 usa SSL; 587 usa STARTTLS. EMAIL_REMETENTE é opcional (padrão: SMTP_USER).
# EMAIL_DESTINO_TESTE: se preenchido, TODO e-mail vai para ele.
# EMAIL_ENVIO_REAL=true libera o envio ao destinatário real (só em produção e com EMAIL_DESTINO_TESTE vazio).
# Sem nenhum dos dois, o envio é recusado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=
EMAIL_DESTINO_TESTE=
EMAIL_ENVIO_REAL=
