# Supabase: use o Transaction pooler (porta 6543), não a conexão direta.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=no-verify
JWT_SECRET=troque-por-um-segredo-longo
# Só use true localmente. Na Vercel é ignorado.
ERASE_DATABASE_ON_SYNC=false

# Usado apenas por: npm run seed:admin
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
